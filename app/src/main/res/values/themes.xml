<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RomanismReader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/background_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!--
      ریدر PDF جتپک (androidx.pdf) داخل خودش یه FloatingActionButton خام
      MaterialComponents می‌سازه که به کل ست رنگ‌های استاندارد Material
      (colorSecondary و بقیه) نیاز داره. تم بالا چون بعضی رنگ‌ها رو دستی
      override کرده، این زنجیره رو می‌شکنه و باعث کرش inflate می‌شه.
      برای همین به‌جای اون تم سفارشی، اینجا از نسخه‌ی کاملاً خام و
      دست‌نخورده‌ی MaterialComponents استفاده می‌کنیم.
    -->
    <style name="Theme.RomanismReader.PdfViewer" parent="Theme.MaterialComponents.DayNight.NoActionBar" />
</resources>
